{
  "name": "forge-dsp-gui-ng",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Web-Bedienoberfläche für Forge DSP / ETON CORE D8 (USB per Web Serial oder ESP32 per WebSocket)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/gzip-dist.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && vitest run --config vitest.render.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@tsconfig/svelte": "5.0.8",
    "happy-dom": "15.11.7",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4"
  }
}
